# Copy to .env.local and fill in. Never commit .env.local.
AUTH0_DOMAIN=
# Identifier of the Auth0 API, identical in frontend/.env.local
AUTH0_AUDIENCE=https://api.plumarc
# Must use the plumarc_auth role. Add ?sslmode=require when not using an SSH tunnel.
DATABASE_URL=postgresql://plumarc_auth:CHANGE_ME@localhost:5432/postgres
