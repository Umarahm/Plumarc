# Copy to .env.local and fill in. Never commit .env.local.

# Auth0 application of type "Regular Web Application"
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Encrypts session cookies and signs CSRF tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=
# Identifier of the Auth0 API, identical in auth/.env.local
AUTH0_AUDIENCE=https://api.plumarc

APP_BASE_URL=http://localhost:3000
# Backend service, called from the Next.js server only
API_URL=http://localhost:8000
